VITE_API_URL=http://localhost:3000
VITE_AGENT_BACKEND=1
# Live voice token source: "local" (default) asks our own API (POST /v1/voice/room-token)
# for a room token signed by the self-hosted LiveKit server; "cloud" keeps the legacy
# LiveKit Cloud dev token server flow.
# VITE_LIVEKIT_TOKEN_SOURCE=local
# Development-only LiveKit Cloud token server ID. Cloud-only: ignored when the token
# source is "local".
VITE_LIVEKIT_TOKEN_SERVER_ID=
# Cloud-only: agent name sent to the dev token server. Under "local" the server's
# LIVEKIT_AGENT_NAME decides agent dispatch and this value is ignored.
VITE_LIVEKIT_AGENT_NAME=nani-agent
# Sanity check on both paths: the browser verifies the room token identity matches.
# The identity itself is server-owned; the frontend never chooses it.
VITE_LIVEKIT_PARTICIPANT_IDENTITY=11111111-1111-4111-8111-111111111111
# LiveKit Cloud returns a short-lived room token at runtime. Never place API
# secrets or binding private keys in VITE_* values.
